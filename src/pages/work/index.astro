---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { CATEGORY_LABELS } from '~/lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/** Only categories that something actually uses become filter chips. */
const used = new Set(projects.flatMap((p) => p.data.categories));
const filters = (Object.keys(CATEGORY_LABELS) as (keyof typeof CATEGORY_LABELS)[]).filter((c) =>
  used.has(c),
);

/**
 * "Impact" order is editorial, not computed - it is the order I would show these in an
 * interview. It is declared here rather than inferred from a score, so nothing pretends
 * to be a measurement.
 */
const IMPACT = [
  'offroad-bevfusion',
  'langgrasp',
  'aeroedge',
  'sigint-fusion',
  'makerspace-reuse-scanner',
  'hw-validation-agent',
  'sparsedrive',
  'embedded-codegen-lm',
  'scalable-4d-perception',
  'latentsync-optimization',
];
---

<Base
  title="Work"
  description="Ten projects in 3D perception, sensor fusion, edge deployment and retrieval, each with its measured numbers and its honest limits."
  path="/work"
>
  <div class="wrap work">
    <header class="work__head">
      <p class="kicker">Work</p>
      <h1 class="work__title">Ten projects, every number measured</h1>
      <p class="lede">
        Filter by what you are hiring for. Each case study carries the hardware each number was
        measured on, and a panel listing what failed or could not be measured.
      </p>
    </header>

    <div class="work__controls">
      <fieldset class="work__filters">
        <legend class="sr-only">Filter projects by area</legend>
        <button class="work__chip" type="button" data-filter="all" aria-pressed="true">
          All <span class="mono" data-count-all>{projects.length}</span>
        </button>
        {
          filters.map((c) => (
            <button class="work__chip" type="button" data-filter={c} aria-pressed="false">
              {CATEGORY_LABELS[c]}
              <span class="mono">
                {projects.filter((p) => p.data.categories.includes(c)).length}
              </span>
            </button>
          ))
        }
      </fieldset>

      <div class="work__opts">
        <label class="work__select">
          <span>Sort</span>
          <select data-sort>
            <option value="recent">Most recent</option>
            <option value="impact">By impact</option>
          </select>
        </label>
        <div class="work__view" role="group" aria-label="Layout">
          <button type="button" data-view-btn="grid" aria-pressed="true">Grid</button>
          <button type="button" data-view-btn="list" aria-pressed="false">List</button>
        </div>
      </div>
    </div>

    <p class="work__status" role="status" data-work-status></p>

    <div class="work__grid" data-work-grid data-view="grid">
      {
        projects.map((project) => (
          <div
            class="work__cell"
            data-project={project.id}
            data-categories={project.data.categories.join(' ')}
            data-recent={project.data.order}
            data-impact={IMPACT.indexOf(project.id)}
          >
            <ProjectCard project={project} as="h2" />
          </div>
        ))
      }
    </div>

    <p class="work__empty" hidden data-work-empty>
      Nothing matches that filter. <button type="button" data-work-reset>Show everything</button>
    </p>
  </div>
</Base>

<style>
  .work {
    padding-block: clamp(2.5rem, 7vh, 4rem) 3rem;
  }
  .work__title {
    font-size: var(--t-h1);
    margin-block: 0.7rem 1rem;
  }
  .work__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .work__filters {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .work__chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: var(--t-sm);
    color: var(--fg-muted);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.85rem;
    cursor: pointer;
    transition:
      border-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .work__chip span {
    font-size: var(--t-xs);
    color: var(--fg-dim);
  }
  .work__chip:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }
  .work__chip[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .work__chip[aria-pressed='true'] span {
    color: var(--accent);
  }
  .work__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }
  .work__select {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--fg-muted);
  }
  .work__select select {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.32rem 0.55rem;
    font-size: var(--t-sm);
  }
  .work__view {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .work__view button {
    background: var(--bg-elev);
    border: 0;
    padding: 0.35rem 0.8rem;
    font-size: var(--t-sm);
    color: var(--fg-muted);
    cursor: pointer;
  }
  .work__view button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .work__status {
    margin-top: 1rem;
    font-size: var(--t-xs);
    color: var(--fg-dim);
    min-height: 1.2em;
  }
  .work__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
  .work__grid[data-view='list'] {
    grid-template-columns: minmax(0, 1fr);
  }
  .work__cell[hidden] {
    display: none;
  }
  .work__empty {
    margin-top: 2rem;
    color: var(--fg-muted);
  }
  .work__empty button {
    background: none;
    border: 0;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
</style>

<script>
  /**
   * Filter, sort and layout state lives in the URL, so a filtered view is a link you
   * can send someone. No framework: this is three attributes and a sort.
   */
  function wireWork() {
    const gridEl = document.querySelector<HTMLElement>('[data-work-grid]');
    if (!gridEl || gridEl.dataset.wired) return;
    const grid = gridEl;
    grid.dataset.wired = '1';

    const cells = [...grid.querySelectorAll<HTMLElement>('[data-project]')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]');
    const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
    const status = document.querySelector<HTMLElement>('[data-work-status]');
    const empty = document.querySelector<HTMLElement>('[data-work-empty]');
    const reset = document.querySelector<HTMLButtonElement>('[data-work-reset]');

    const state = { filter: 'all', sort: 'recent', view: 'grid' };

    function readUrl() {
      const q = new URLSearchParams(location.search);
      state.filter = q.get('area') ?? 'all';
      state.sort = q.get('sort') === 'impact' ? 'impact' : 'recent';
      state.view = q.get('view') === 'list' ? 'list' : 'grid';
    }

    function writeUrl() {
      const q = new URLSearchParams();
      if (state.filter !== 'all') q.set('area', state.filter);
      if (state.sort !== 'recent') q.set('sort', state.sort);
      if (state.view !== 'grid') q.set('view', state.view);
      const url = q.toString() ? `?${q}` : location.pathname;
      history.replaceState(null, '', url);
    }

    function apply() {
      chips.forEach((c) =>
        c.setAttribute('aria-pressed', String(c.dataset.filter === state.filter)),
      );
      viewBtns.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.viewBtn === state.view)),
      );
      if (sortSel) sortSel.value = state.sort;
      grid.dataset.view = state.view;

      let shown = 0;
      cells.forEach((cell) => {
        const cats = (cell.dataset.categories ?? '').split(' ');
        const match = state.filter === 'all' || cats.includes(state.filter);
        cell.hidden = !match;
        if (match) shown++;
        // The card's own layout follows the toggle.
        cell.querySelector('.card')?.classList.toggle('card--list', state.view === 'list');
        cell.querySelector('.card')?.classList.toggle('card--grid', state.view === 'grid');
      });

      const key = state.sort === 'impact' ? 'impact' : 'recent';
      [...cells]
        .sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]))
        .forEach((cell) => grid.appendChild(cell));

      if (status) {
        const label =
          state.filter === 'all'
            ? `Showing all ${shown} projects`
            : `Showing ${shown} of ${cells.length} projects`;
        status.textContent = `${label}, sorted ${state.sort === 'impact' ? 'by impact' : 'most recent first'}.`;
      }
      if (empty) empty.hidden = shown > 0;
      writeUrl();
    }

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        state.filter = chip.dataset.filter ?? 'all';
        apply();
      }),
    );
    sortSel?.addEventListener('change', () => {
      state.sort = sortSel.value;
      apply();
    });
    viewBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        state.view = btn.dataset.viewBtn ?? 'grid';
        apply();
      }),
    );
    reset?.addEventListener('click', () => {
      state.filter = 'all';
      apply();
    });

    readUrl();
    apply();
  }
  wireWork();
  document.addEventListener('astro:page-load', wireWork);
</script>
