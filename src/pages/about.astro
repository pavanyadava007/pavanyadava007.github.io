---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { site } from '~/lib/site';
import { dateRange } from '~/lib/format';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');

const measuredCount = projects.reduce((n, p) => n + p.data.metrics.length, 0);
const limitCount = projects.reduce((n, p) => n + p.data.limits.length, 0);
---

<Base
  title="About"
  description="Perception engineer who ships to hardware. Background, timeline, and how I decide a number is worth publishing."
  path="/about"
>
  <div class="wrap about">
    <header class="about__head">
      <p class="kicker">About</p>
      <h1 class="about__title">Perception engineer who ships to hardware</h1>
      <p class="lede">
        3+ years in automotive ADAS and perception at Continental AG and AUMOVIO, currently
        researching end-to-end autonomy alongside an M.Sc. in AI for Autonomous Driving at FAU
        Erlangen-Nürnberg. I build perception systems the whole way down: BEV LiDAR-camera-radar
        fusion, transformer encoders and multitask heads, then the unglamorous part - ONNX, TensorRT
        FP16/INT8, ROS 2 C++, Rust, OTA fleet rollout - until it runs in real time on hardware I can
        actually measure.
      </p>
      <div class="about__actions">
        <a class="btn btn--primary" href={site.cv} download>Download CV (PDF)</a>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.social.github} rel="noopener">GitHub</a>
        <a class="btn" href={site.social.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </header>

    <section class="about__section" aria-labelledby="process-heading">
      <h2 id="process-heading" class="about__h2">How I decide a number is worth publishing</h2>
      <ol class="about__rules">
        <li>
          <h3>It was measured on hardware I can name.</h3>
          <p>
            Every figure on this site carries the GPU or CPU it ran on. There are
            {measuredCount} of them. Where a target device does not exist - Jetson Orin, a Pi 5, a Coral
            - the row stays empty rather than being extrapolated from an L4.
          </p>
        </li>
        <li>
          <h3>The split cannot leak.</h3>
          <p>
            The hardware-validation work splits by device serial rather than by row, because
            measurements from one die are not independent. A number that would look better on a
            random split is not a better number.
          </p>
        </li>
        <li>
          <h3>The thing that did not work is written down too.</h3>
          <p>
            {limitCount} limits are published across these projects, from INT8 measuring slower than FP32
            on the CPU it shipped on, to synthetic pretraining failing to transfer to real RF frames,
            to an ACT policy that plateaued at 55 of 100. The
            <a href="/lab">lab page</a> collects them.
          </p>
        </li>
        <li>
          <h3>Safety cases are written before the code, not after the demo.</h3>
          <p>
            ISO 26262 (ASIL-B) and ISO 21448 (SOTIF) are how I was trained to work, so the robotics
            and perception projects carry hazard analyses, deterministic overrides over learned
            components, and release gates that are allowed to refuse.
          </p>
        </li>
      </ol>
    </section>

    <section class="about__section" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="about__h2">Timeline</h2>
      <ol class="tl" data-timeline>
        <span class="tl__fill" aria-hidden="true"></span>
        {
          experience.map((entry) => (
            <li class="tl__item" data-kind={entry.data.kind}>
              <p class="tl__when mono">{dateRange(entry.data.start, entry.data.end)}</p>
              <details open={entry.data.bullets.length > 0}>
                <summary>
                  <span class="tl__role">{entry.data.role}</span>
                  <span class="tl__org">
                    {entry.data.org}
                    {entry.data.location && <> · {entry.data.location}</>}
                  </span>
                </summary>
                {entry.data.bullets.length > 0 && (
                  <ul class="tl__bullets">
                    {entry.data.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about__section" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="about__h2">What I work with</h2>
      <dl class="about__skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.data.group}</dt>
              <dd>{group.data.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="about__section" aria-labelledby="avail-heading">
      <h2 id="avail-heading" class="about__h2">Availability</h2>
      <p class="lede">
        Based in {site.location}, {site.availability}. Open to perception, sensor-fusion and
        edge-deployment roles in Germany. English C1, German B2.
      </p>
      <div class="about__actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.cv} download>Download CV (PDF)</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .about {
    padding-block: clamp(2.5rem, 7vh, 4rem) 3rem;
  }
  .about__title {
    font-size: var(--t-h1);
    margin-block: 0.7rem 1rem;
    max-width: 20ch;
  }
  .about__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .about__section {
    margin-top: 4rem;
  }
  .about__h2 {
    font-size: var(--t-h2);
    margin-bottom: 1.5rem;
  }

  .about__rules {
    list-style: none;
    counter-reset: rule;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .about__rules li {
    counter-increment: rule;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.3rem 1.4rem;
  }
  .about__rules li::before {
    content: counter(rule, decimal-leading-zero);
    font-family: var(--font-mono-stack);
    font-size: var(--t-xs);
    color: var(--accent);
  }
  .about__rules h3 {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }
  .about__rules p {
    margin-top: 0.6rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
  }
  /* An inline link inside body text needs either 3:1 against the surrounding text or a
     non-colour cue. Accent on muted is 1.65:1, so it gets an underline. */
  .about__rules a {
    color: var(--accent);
    text-decoration: underline;
  }

  .tl {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .tl__fill {
    position: absolute;
    left: -1px;
    top: 0;
    width: 1px;
    height: var(--fill, 0%);
    background: var(--accent);
    transition: height 120ms linear;
  }
  .tl__item {
    position: relative;
    display: grid;
    gap: 0.35rem 2rem;
    padding: 0 0 2.25rem 1.75rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 820px) {
    .tl__item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .tl__item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--accent);
    z-index: 1;
  }
  .tl__item[data-kind='education']::before {
    border-color: var(--fg-dim);
  }
  .tl__when {
    color: var(--fg-dim);
    font-size: var(--t-xs);
    padding-top: 0.15rem;
  }
  .tl summary {
    cursor: pointer;
    display: grid;
    gap: 0.15rem;
    list-style: none;
  }
  .tl summary::-webkit-details-marker {
    display: none;
  }
  .tl__role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
  }
  .tl__org {
    font-size: var(--t-sm);
    color: var(--fg-muted);
  }
  .tl__bullets {
    margin-top: 0.7rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
  }

  .about__skills {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0;
  }
  .about__skills > div {
    background: var(--bg-elev);
    padding: 1rem 1.15rem;
    display: grid;
    gap: 0.3rem 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 820px) {
    .about__skills > div {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
  }
  .about__skills dt {
    font-family: var(--font-mono-stack);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .about__skills dd {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--t-sm);
  }
</style>

<script>
  /** The timeline's line fills as it scrolls past, which is the page's only scroll effect. */
  function wireTimeline() {
    const tl = document.querySelector<HTMLElement>('[data-timeline]');
    if (!tl || tl.dataset.wired) return;
    tl.dataset.wired = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      tl.style.setProperty('--fill', '100%');
      return;
    }
    let ticking = false;
    const update = () => {
      const r = tl.getBoundingClientRect();
      const mid = window.innerHeight * 0.55;
      const pct = Math.min(100, Math.max(0, ((mid - r.top) / r.height) * 100));
      tl.style.setProperty('--fill', `${pct}%`);
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  wireTimeline();
  document.addEventListener('astro:page-load', wireTimeline);
</script>
