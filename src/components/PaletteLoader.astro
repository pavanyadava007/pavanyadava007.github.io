---
import { buildPaletteItems } from '~/lib/palette';
const items = await buildPaletteItems();
---

{/* The palette's data is inlined as JSON; its code is fetched on first use. */}
<div id="palette-host"></div>
<script type="application/json" id="palette-items" set:html={JSON.stringify(items)} is:inline
></script>

<script>
  /**
   * Tiny always-on shim. The React palette itself (React + cmdk, ~60 kB) is fetched
   * only when someone actually opens it, which is what keeps `/` inside the initial
   * JS budget.
   */
  let mounted = false;

  async function open() {
    if (mounted) {
      document.dispatchEvent(new CustomEvent('palette:open'));
      return;
    }
    const host = document.getElementById('palette-host');
    const data = document.getElementById('palette-items');
    if (!host || !data?.textContent) return;
    mounted = true;
    const { mountPalette } = await import('~/lib/mount-palette');
    await mountPalette(JSON.parse(data.textContent), host);
  }

  function wirePalette() {
    document.querySelectorAll('[data-open-palette]').forEach((el) => {
      if ((el as HTMLElement).dataset.wired) return;
      (el as HTMLElement).dataset.wired = '1';
      el.addEventListener('click', open);
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      void open();
    }
  });

  wirePalette();
  document.addEventListener('astro:page-load', wirePalette);
</script>
