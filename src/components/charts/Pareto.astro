---
import { scaleLinear } from 'd3-scale';

export interface ParetoPoint {
  label: string;
  latency: number;
  map: number;
  sizeMb: number;
  precision: 'fp32' | 'int8';
  shipped?: boolean;
  /** Draw an arrow from this point's label to show the quantization step. */
  quantizedFrom?: string;
}

interface Props {
  title: string;
  caption: string;
  subtitle: string;
  points: ParetoPoint[];
  source?: string;
}

const { title, caption, subtitle, points, source } = Astro.props;

const W = 720;
const H = 400;
const M = { top: 22, right: 26, bottom: 46, left: 62 };

const xs = points.map((p) => p.latency);
const ys = points.map((p) => p.map);
const x = scaleLinear()
  .domain([Math.min(...xs) - 2, Math.max(...xs) + 2])
  .nice()
  .range([M.left, W - M.right]);
const y = scaleLinear()
  .domain([Math.min(...ys) - 0.03, Math.max(...ys) + 0.03])
  .nice()
  .range([H - M.bottom, M.top]);
const r = scaleLinear()
  .domain([Math.min(...points.map((p) => p.sizeMb)), Math.max(...points.map((p) => p.sizeMb))])
  .range([6, 17]);

const placed = points.map((p) => ({ ...p, cx: x(p.latency), cy: y(p.map), rr: r(p.sizeMb) }));
const byLabel = new Map(placed.map((p) => [p.label, p]));

/**
 * The Pareto front is the set of points nothing beats on both axes (lower latency AND
 * higher accuracy). Computed, not drawn by hand, so it cannot flatter the data.
 */
const front = placed
  .filter((p) => !placed.some((q) => q !== p && q.latency <= p.latency && q.map >= p.map))
  .sort((a, b) => a.latency - b.latency);

const arrows = placed
  .filter((p) => p.quantizedFrom)
  .map((p) => ({ from: byLabel.get(p.quantizedFrom!)!, to: p }))
  .filter((a) => a.from);

const COLOR = { fp32: 'var(--accent)', int8: 'var(--accent-2)' };
---

<figure class="pareto" id="pareto">
  <figcaption class="pareto__head">
    <h3 class="pareto__title">{title}</h3>
    <p class="pareto__sub">{subtitle}</p>
  </figcaption>

  <div class="pareto__legend">
    <span><i style={`background:${COLOR.fp32}`}></i>FP32</span>
    <span><i style={`background:${COLOR.int8}`}></i>INT8</span>
    <span class="pareto__hint">Down and to the right = worse on both axes</span>
    <label class="pareto__toggle">
      <input type="checkbox" data-pareto-radius />
      Point size = file size
    </label>
  </div>

  <div class="pareto__scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`${title}. ${subtitle} The same values are in the table below.`}
      data-pareto
    >
      <defs>
        <marker
          id="pareto-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0,1 L9,5 L0,9" fill="none" stroke="var(--fg-dim)" stroke-width="1.6"></path>
        </marker>
      </defs>

      <g class="pareto__grid">
        {y.ticks(5).map((t) => <line x1={M.left} x2={W - M.right} y1={y(t)} y2={y(t)} />)}
        {x.ticks(5).map((t) => <line y1={M.top} y2={H - M.bottom} x1={x(t)} x2={x(t)} />)}
      </g>

      <g class="pareto__axis">
        {
          y.ticks(5).map((t) => (
            <text x={M.left - 10} y={y(t) + 4} text-anchor="end">
              {t.toFixed(2)}
            </text>
          ))
        }
        {
          x.ticks(5).map((t) => (
            <text x={x(t)} y={H - M.bottom + 20} text-anchor="middle">
              {t}
            </text>
          ))
        }
        <text class="pareto__axis-title" x={(W + M.left) / 2} y={H - 8} text-anchor="middle">
          p95 latency (ms), lower is better
        </text>
        <text
          class="pareto__axis-title"
          x={16}
          y={(H - M.bottom + M.top) / 2}
          text-anchor="middle"
          transform={`rotate(-90 16 ${(H - M.bottom + M.top) / 2})`}
        >
          mAP@0.5, higher is better
        </text>
      </g>

      {
        front.length > 1 && (
          <polyline class="pareto__front" points={front.map((p) => `${p.cx},${p.cy}`).join(' ')} />
        )
      }

      {
        arrows.map((a) => (
          <line
            class="pareto__step"
            x1={a.from.cx}
            y1={a.from.cy}
            x2={a.to.cx}
            y2={a.to.cy}
            marker-end="url(#pareto-arrow)"
          />
        ))
      }

      {
        placed.map((p) => (
          <g class="pareto__pt" data-label={p.label}>
            <circle
              cx={p.cx}
              cy={p.cy}
              r="7"
              data-r-fixed="7"
              data-r-size={p.rr.toFixed(1)}
              fill={COLOR[p.precision]}
            />
            <text x={p.cx} y={p.cy - 15} text-anchor="middle">
              {p.label}
            </text>
            {p.shipped && (
              <text class="pareto__shipped" x={p.cx} y={p.cy + 26} text-anchor="middle">
                shipped build, {p.sizeMb} MB
              </text>
            )}
            <title>
              {p.label}: p95 {p.latency} ms, mAP@0.5 {p.map}, {p.sizeMb} MB
            </title>
          </g>
        ))
      }
    </svg>
  </div>

  <p class="pareto__caption">{caption}</p>

  <details class="pareto__table" open>
    <summary>Table view</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">Variant</th>
          <th scope="col">p95 latency</th>
          <th scope="col">mAP@0.5</th>
          <th scope="col">File size</th>
          <th scope="col">On the Pareto front</th>
        </tr>
      </thead>
      <tbody>
        {
          placed.map((p) => (
            <tr>
              <th scope="row">{p.label}</th>
              <td class="mono">{p.latency} ms</td>
              <td class="mono">{p.map.toFixed(3)}</td>
              <td class="mono">{p.sizeMb} MB</td>
              <td>{front.includes(p) ? 'yes' : 'no'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>

  {
    source && (
      <p class="pareto__source">
        <a href={source} rel="noopener">
          Source measurements →
        </a>
      </p>
    )
  }
</figure>

<style>
  .pareto {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.4rem 1.4rem 1.2rem;
    scroll-margin-top: 6rem;
  }
  .pareto__title {
    font-size: var(--t-h3);
  }
  .pareto__sub {
    margin-top: 0.35rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
    max-width: 68ch;
  }
  .pareto__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: var(--t-xs);
    color: var(--fg-muted);
  }
  .pareto__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .pareto__legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .pareto__hint {
    color: var(--fg-dim);
  }
  .pareto__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    margin-inline-start: auto;
  }
  .pareto__scroll {
    margin-top: 0.75rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .pareto svg {
    display: block;
    width: 100%;
    min-width: 520px;
    height: auto;
    font-family: var(--font-ui-stack);
    font-size: 12px;
  }
  .pareto__grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .pareto__axis text {
    fill: var(--fg-dim);
    font-size: 11.5px;
  }
  .pareto__axis-title {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .pareto__front {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 5 5;
    opacity: 0.5;
  }
  .pareto__step {
    stroke: var(--fg-dim);
    stroke-width: 1.5;
  }
  .pareto__pt circle {
    stroke: var(--bg-elev);
    stroke-width: 2;
    transition: r 200ms var(--ease);
  }
  .pareto__pt text {
    fill: var(--fg);
    font-size: 12px;
    font-weight: 600;
  }
  .pareto__shipped {
    fill: var(--fg-dim) !important;
    font-size: 11px !important;
    font-weight: 400 !important;
  }
  .pareto__caption {
    margin-top: 1rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
    max-width: 68ch;
  }
  .pareto__table {
    margin-top: 1rem;
  }
  .pareto__table summary {
    font-size: var(--t-sm);
    color: var(--fg-muted);
    cursor: pointer;
  }
  .pareto__table table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 0.7rem;
    font-size: var(--t-xs);
  }
  .pareto__table th,
  .pareto__table td {
    text-align: left;
    padding: 0.4rem 0.8rem 0.4rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-muted);
    font-weight: 400;
  }
  .pareto__table thead th {
    color: var(--fg-dim);
    font-weight: 600;
  }
  .pareto__source {
    margin-top: 0.8rem;
    font-size: var(--t-xs);
  }
  .pareto__source a {
    color: var(--accent);
  }
</style>

<script>
  function wirePareto() {
    document.querySelectorAll<HTMLElement>('.pareto').forEach((fig) => {
      if (fig.dataset.wired) return;
      fig.dataset.wired = '1';
      const toggle = fig.querySelector<HTMLInputElement>('[data-pareto-radius]');
      const circles = fig.querySelectorAll<SVGCircleElement>('[data-r-size]');
      toggle?.addEventListener('change', () => {
        circles.forEach((c) => {
          const next = toggle.checked ? c.dataset.rSize : c.dataset.rFixed;
          if (next) c.setAttribute('r', next);
        });
      });
    });
  }
  wirePareto();
  document.addEventListener('astro:page-load', wirePareto);
</script>
