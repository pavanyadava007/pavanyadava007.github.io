---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  caption: string;
  before: { image: ImageMetadata; alt: string; label: string };
  after: { image: ImageMetadata; alt: string; label: string };
}

const { title, caption, before, after } = Astro.props;
---

<figure class="cmp">
  <figcaption class="cmp__head">
    <h3 class="cmp__title">{title}</h3>
  </figcaption>

  <div class="cmp__stage" data-compare style="--split: 50%">
    <div class="cmp__layer cmp__layer--after">
      <Image src={after.image} alt={after.alt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 760px, 92vw" formats={['avif', 'webp']} loading="lazy" />
      <span class="cmp__label cmp__label--after">{after.label}</span>
    </div>
    <div class="cmp__layer cmp__layer--before">
      <Image src={before.image} alt={before.alt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 760px, 92vw" formats={['avif', 'webp']} loading="lazy" />
      <span class="cmp__label cmp__label--before">{before.label}</span>
    </div>
    <span class="cmp__handle" aria-hidden="true"></span>
    <input
      class="cmp__input"
      type="range"
      min="0"
      max="100"
      value="50"
      step="0.5"
      data-compare-input
      aria-label={`Wipe between ${before.label} and ${after.label}`}
    />
  </div>

  <p class="cmp__caption">{caption}</p>
</figure>

<style>
  .cmp {
    margin: 0;
  }
  .cmp__title {
    font-size: var(--t-h3);
  }
  .cmp__stage {
    position: relative;
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunk);
    isolation: isolate;
  }
  .cmp__layer {
    inset: 0;
  }
  .cmp__layer--after {
    position: relative;
  }
  .cmp__layer--before {
    position: absolute;
    /* The before image is clipped to the split, so the two align pixel for pixel. */
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }
  .cmp__layer :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cmp__label {
    position: absolute;
    bottom: 0.7rem;
    font-family: var(--font-mono-stack);
    font-size: var(--t-xs);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.18rem 0.7rem;
    color: var(--fg);
  }
  .cmp__label--before {
    left: 0.7rem;
  }
  .cmp__label--after {
    right: 0.7rem;
  }
  .cmp__handle {
    position: absolute;
    inset-block: 0;
    left: var(--split);
    width: 2px;
    background: var(--accent);
    transform: translateX(-1px);
    pointer-events: none;
  }
  .cmp__handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.1rem;
    height: 2.1rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bg-elev);
    border: 2px solid var(--accent);
  }
  .cmp__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .cmp__input:focus-visible + .cmp__handle,
  .cmp__stage:has(.cmp__input:focus-visible) .cmp__handle::after {
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .cmp__caption {
    margin-top: 0.9rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
    max-width: 68ch;
  }
</style>

<script>
  function wireCompare() {
    document.querySelectorAll<HTMLElement>('[data-compare]').forEach((stage) => {
      if (stage.dataset.wired) return;
      stage.dataset.wired = '1';
      const input = stage.querySelector<HTMLInputElement>('[data-compare-input]');
      if (!input) return;
      const apply = () => stage.style.setProperty('--split', `${input.value}%`);
      input.addEventListener('input', apply);
      apply();
    });
  }
  wireCompare();
  document.addEventListener('astro:page-load', wireCompare);
</script>
