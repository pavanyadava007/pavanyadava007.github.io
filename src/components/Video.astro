---
interface Props {
  /** Base name in public/media, e.g. "showcase" for showcase.mp4 + showcase.av1.mp4. */
  name: string;
  caption: string;
  /** Description of the footage, for people who cannot watch it. */
  description: string;
  width: number;
  height: number;
  loop?: boolean;
}

const { name, caption, description, width, height, loop = false } = Astro.props;
---

<figure class="vid">
  {
    /* preload="none": nothing is fetched until the visitor presses play. The poster
      reserves the box, so there is no layout shift either way. */
  }
  <video
    controls
    muted
    playsinline
    loop={loop}
    preload="none"
    poster={`/media/${name}-poster.jpg`}
    width={width}
    height={height}
    aria-describedby={`${name}-desc`}
  >
    <source src={`/media/${name}.av1.mp4`} type="video/mp4; codecs=av01.0.05M.08" />
    <source src={`/media/${name}.mp4`} type="video/mp4; codecs=avc1.640028" />
    <p>
      Your browser cannot play this video. <a href={`/media/${name}.mp4`}>Download the MP4</a>.
    </p>
  </video>
  <figcaption id={`${name}-desc`}>
    {caption}
    <span class="sr-only">{description}</span>
  </figcaption>
</figure>

<style>
  .vid {
    margin: 0;
  }
  .vid video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #000;
  }
  .vid figcaption {
    margin-top: 0.7rem;
    color: var(--fg-muted);
    font-size: var(--t-sm);
    max-width: 68ch;
  }
</style>
